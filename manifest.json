{
  "manifest_version": 3,
  "name": "DumbTube",
  "version": "1.4.0",
  "description": "Search, watch, skip the rest. Hides YouTube Shorts, feeds and sponsored cards, skips video ads, and hides Google ads on other sites.",
  "icons": {
    "16": "icons/dumbtube-16x16.png",
    "48": "icons/dumbtube-48x48.png",
    "128": "icons/dumbtube-128x128.png"
  },
  "action": {
    "default_title": "DumbTube",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/dumbtube-16x16.png",
      "48": "icons/dumbtube-48x48.png",
      "128": "icons/dumbtube-128x128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "alarms", "activeTab"],
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause hiding for 10 minutes, or resume"
    },
    "toggle-focus-timer": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Start or stop the focus timer"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": [
        "src/shared/settings.js",
        "src/youtube/core.js",
        "src/youtube/sponsored.js",
        "src/youtube/shorts.js",
        "src/youtube/playables.js",
        "src/youtube/page-layout.js",
        "src/youtube/focus-timer.js",
        "src/youtube/daily-limit.js",
        "src/youtube/video-ads.js",
        "src/youtube/autoplay.js",
        "src/youtube/main.js"
      ],
      "css": ["src/youtube/youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.youtube.com/*"],
      "js": ["src/shared/settings.js", "src/sites/google-ads.js"],
      "css": ["src/sites/google-ads.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
